# Token from @BotFather (required)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# ID of the support supergroup with Topics enabled (required).
# Supergroup IDs start with -100, e.g. -1001234567890
SUPPORT_GROUP_ID=-1001234567890

# Path to the SQLite database file (optional, default: ./data/bot.sqlite)
DB_PATH=./data/bot.sqlite

# Texts shown to users, per language (all optional; built-in defaults are used if unset).
# The user's language comes from /settings, or from their Telegram language if they never chose one.
# Auto-reply sent to a user on their first message
# GREETING_TEXT_UK=Дякуємо за звернення! Ваше повідомлення отримано та обробляється.
# GREETING_TEXT_EN=Thanks for reaching out! Your message has been received and is being processed.
# Reply to /start
# START_TEXT_UK=Вітаємо! Напишіть своє питання тут, і наша команда підтримки відповість вам.
# START_TEXT_EN=Hi! Send your question here and our support team will get back to you.

# Hours of silence after which the user's next message starts a new question (optional, default: 12)
SESSION_IDLE_HOURS=12

# Phone number given to users when their question times out without an answer (optional)
SUPPORT_PHONE=+380505255167

# Log level: debug | info | warn | error (optional, default: info)
LOG_LEVEL=info
